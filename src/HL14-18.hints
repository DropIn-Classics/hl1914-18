; HL14-18.EXE: launcher program
; Hints for doskit/tools/disasm.py; numbers are hex.

exe HL14-18.EXE
linker tlink 50 header=original

; Frames from the program's relocation table; SS:SP = 0296:0100.
; size/start keep cross-frame routine tails with their original CS frame.
; Boundaries follow decoded instruction continuations through RETF or JMP.
; C00B2:0059-005A and C012C:0064-0069 are CS-relative variables
; referenced by those routines and remain with their original frame.
segment CODE  0000 CODE size=155
segment C0015 0015 CODE prefix=C0015 start=5
segment C00A4 00A4 CODE prefix=C00A4 size=36
segment C00A7 00A7 CODE prefix=C00A7 start=6
segment C00B2 00B2 CODE prefix=C00B2 size=5B
segment C00B7 00B7 CODE prefix=C00B7 start=B size=27
segment C00B9 00B9 CODE prefix=C00B9 start=7
segment C00BB 00BB CODE prefix=C00BB
segment C00BD 00BD CODE prefix=C00BD size=CD
segment C00C9 00C9 CODE prefix=C00C9 start=D
segment C00DA 00DA CODE prefix=C00DA
segment C00E0 00E0 CODE prefix=C00E0 size=24
segment C00E2 00E2 CODE prefix=C00E2 start=4 size=F2
segment C00F1 00F1 CODE prefix=C00F1 start=2 size=31
segment C00F4 00F4 CODE prefix=C00F4 start=1 size=F7
segment C0103 0103 CODE prefix=C0103 start=7 size=5C
segment C0108 0108 CODE prefix=C0108 start=C
segment C012C 012C CODE prefix=C012C size=6A
segment C0132 0132 CODE prefix=C0132 start=A
segment C013F 013F CODE prefix=C013F size=122
segment C0151 0151 CODE prefix=C0151 start=2 size=C5
segment C015D 015D CODE prefix=C015D start=5 size=124
segment C016F 016F CODE prefix=C016F start=4 size=18
segment C0170 0170 CODE prefix=C0170 start=8 size=38
segment C0173 0173 CODE prefix=C0173 start=8
segment DATA  01AE DATA
segment STACK 0296 STACK stack size=100

relocorder original

name CODE:000B launcher_entry
name C016F:0004 trim_dos_memory_block
name CODE:0042 launch_intro
name CODE:0069 after_intro
name CODE:007D launch_game
name CODE:009A check_game_status
name CODE:00B9 launch_extro
name CODE:010C show_error_prompt
comment C016F:0004 DOS AH=4Ah resizes this process block before child programs run.
comment CODE:0054 EXEC target is INTRO.EXE at DATA:001F.
comment CODE:008F EXEC target is HL.EXE at DATA:0039.
comment CODE:009A AH=4Dh gets the child status; AX is tested against 007Bh.
comment CODE:00B9 Reached after status 007Bh and successful CHDIR to DATA:0029.
comment CODE:00D5 EXEC target is EXTRO.EXE at DATA:002F.
comment CODE:010C Shows an error prompt and waits for a key.

; The reached C0170:0000 physical alias belongs to the continuation of
; C016F:0004; its tail is now decoded in that original CS frame.

; Direct far-call targets found at relocated segment words in this program.
code C0173:0304
code C00A7:0006
code C00BB:0000
code C00B9:0008
code C00E2:0004
code C00A4:000A
code C00C9:000E
code C0103:0008
code C00F1:0002
code C00B7:000C
code C00B2:0004
code C00BD:0000
code C00E0:0000
code C00DA:0008
code C00F4:007C
code C0132:0080
code C013F:0006
code C0151:0002
code C015D:0006
code C0170:0008

; DOS interrupt-vector targets installed by code in C0015.
; INT 21h/AH=25h at C0015:004A installs INT 24 at C0015:055C.
; INT 21h/AH=25h at C0015:059A installs INT 09 at C0015:04F4.
; INT 21h/AH=25h at C0015:0688 installs INT 08 at C0015:06D2.
code C0015:04F4
code C0015:055C
code C0015:06D2

; CS-relative table: C00F4:00A9 reads words until the zero at 00F5.
; The table ends at 00F7, across the next relocation frame.
dptr C00F4:00A4 C00F4
; C0173:030B loads DATA into DS; 0326 reads the far pointer at [BX].
dptr C0173:0311 DATA

; Instructions which tasm.py cannot express yet (build.py output).
raw C0103:0045
raw C0108:009B
raw C0108:00ED
raw C0108:0114
raw C0108:0139
raw C0108:0162
raw C0108:0182
raw C0108:01AA
raw C00B7:001A
raw C0173:0330
raw C0173:0341
raw C0173:0362
raw C0173:0383
